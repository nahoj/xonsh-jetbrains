<idea-plugin>
    <id>eu.nahoj.xonsh.jetbrains</id>
    <name>Xonsh</name>
    <vendor>community</vendor>
    <description><![CDATA[
        Xonsh shell script support for JetBrains IDEs, backed by
        <a href="https://github.com/FoamScience/xonsh-language-server">xonsh-language-server</a>
        via the <a href="https://github.com/redhat-developer/lsp4ij">LSP4IJ</a> client.
        <br/><br/>
        Requires <code>xonsh-lsp</code> on PATH:
        <code>uv tool install 'xonsh-lsp[jedi]'</code>.
    ]]></description>

    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>
    <depends>org.jetbrains.plugins.textmate</depends>

    <extensions defaultExtensionNs="com.intellij.textmate">
        <bundleProvider implementation="eu.nahoj.xonsh.jetbrains.textmate.XonshTmBundleProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server
            id="xonsh"
            name="Xonsh Language Server"
            factoryClass="eu.nahoj.xonsh.jetbrains.lsp.XonshLspServerFactory"/>
        <fileNamePatternMapping
            serverId="xonsh"
            patterns="*.xsh;.xonshrc;xonshrc"
            languageId="xonsh"/>
    </extensions>
</idea-plugin>
